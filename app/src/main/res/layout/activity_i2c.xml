<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for I2cActivity: bus + slave address, bus scan, register read/write,
  raw read/write, and a log output area.
  Same conventions as activity_serial_spi.xml
  (btn_* = action, et_* = input, tv_* = output).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ==================== Navigation ==================== -->
        <Button
            android:id="@+id/btn_open_gpio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="GPIO control page →" />

        <!-- ==================== Bus ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I2C (i2c-dev)"
            android:textColor="#D32F2F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Bus" />

            <EditText
                android:id="@+id/et_i2c_dev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="/dev/i2c-1"
                android:inputType="text"
                android:text="/dev/i2c-1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Slave addr" />

            <EditText
                android:id="@+id/et_i2c_addr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="hex, e.g. 68"
                android:inputType="text"
                android:text="68" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:text="(7-bit, hex)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_i2c_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open" />

            <Button
                android:id="@+id/btn_i2c_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Scan bus" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_i2c_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#EEEEEE"
            android:fontFamily="monospace"
            android:minHeight="40dp"
            android:padding="6dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <!-- ==================== Register access ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Register access"
            android:textColor="#D32F2F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Reg" />

            <EditText
                android:id="@+id/et_i2c_reg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="hex, e.g. 75"
                android:inputType="text"
                android:text="75" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:text="Count" />

            <EditText
                android:id="@+id/et_i2c_len"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="1"
                android:inputType="number"
                android:text="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_i2c_read_reg8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Read 8" />

            <Button
                android:id="@+id/btn_i2c_read_reg16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Read 16" />

            <Button
                android:id="@+id/btn_i2c_read_reg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Read N" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_i2c_wdata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Write data (hex), e.g. 01 or A0 12"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_i2c_write_reg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Write register (+ read-back)" />

        <!-- ==================== Raw transfers ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Raw transfer (no register pointer)"
            android:textColor="#D32F2F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_i2c_raw_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Raw TX hex, e.g. 01 02 AA"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_i2c_raw_write"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Write (raw)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_i2c_raw_len"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Read bytes"
                android:inputType="number"
                android:text="8" />

            <Button
                android:id="@+id/btn_i2c_raw_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Read (raw)" />
        </LinearLayout>

        <!-- ==================== Output ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Log:" />

        <ScrollView
            android:id="@+id/sv_i2c_out"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="2dp"
            android:background="#EEEEEE">

            <TextView
                android:id="@+id/tv_i2c_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
